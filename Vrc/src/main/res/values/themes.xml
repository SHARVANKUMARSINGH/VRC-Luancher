<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.VrcLauncher" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorSecondary">#34A853</item>
        <item name="colorTertiary">#FBBC04</item>
        <item name="colorError">#EA4335</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="AppTheme.SplashScreen" parent="@style/Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/AppTheme.VrcLauncher</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_launcher</item>
        <item name="windowSplashScreenBackground">#141414</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="AppTheme.Fullscreen" parent="AppTheme.VrcLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>